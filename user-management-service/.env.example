# ============================================================
# User Management Service — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Active Spring Profile ────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=user_mgmt_dev
DB_USERNAME=postgres
DB_PASSWORD=change_me_in_production

# ── JWT ──────────────────────────────────────────────────────
# Generate a 512-bit (64-byte) Base64-encoded random key:
#   openssl rand -base64 64
APP_JWT_SECRET=REPLACE_WITH_A_REAL_512_BIT_BASE64_SECRET

# Access token lifetime in milliseconds (default: 15 minutes)
APP_JWT_ACCESS_TOKEN_EXPIRATION_MS=900000

# Refresh token lifetime in milliseconds (default: 30 days)
APP_JWT_REFRESH_TOKEN_EXPIRATION_MS=2592000000

# ── Application ───────────────────────────────────────────────
APP_PORT=8080

# ── Token Cleanup Scheduler ───────────────────────────────────
# How often to purge expired refresh tokens (default: 1 hour)
APP_TOKEN_CLEANUP_INTERVAL_MS=3600000
