# ============================================================
# User Management Service — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ============================================================

# ----- Server -----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ----- Database -----
DB_URL=jdbc:postgresql://localhost:5432/user_management_dev
DB_USERNAME=postgres
DB_PASSWORD=your-secure-database-password

# ----- JWT -----
# Must be a Base64-encoded secret key, minimum 32 characters (256 bits).
# Generate with: openssl rand -base64 64
JWT_SECRET=your-base64-encoded-secret-key-minimum-32-characters-goes-here
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000      # 15 minutes
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7        # 7 days
